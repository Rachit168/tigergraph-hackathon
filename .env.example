# TigerGraph / Savanna connection for Phase 4.
# Copy to .env and fill in local values. Never commit .env.

TG_HOST=https://your-host
TG_GRAPHNAME=OlympicGraph
TG_USERNAME=tigergraph
TG_PASSWORD=
TG_API_TOKEN=
TG_JWT_TOKEN=
TG_SECRET=
TG_RESTPP_PORT=443
TG_GS_PORT=14240
TG_SSL_PORT=443
TG_TGCLOUD=true
TG_CERT_PATH=

# Shared semantic answering (optional). Default generation remains deterministic.
# Set LLM_PROVIDER=openai_compatible to enable the HTTP completion boundary.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=30
# Shared completion cap for RAG, GraphRAG, and Agentic (same SemanticGenerator).
# Freeze is 1024: JSON answers copy verbatim evidence quotes. 512 truncated some live generations.
LLM_MAX_TOKENS=1024

# Optional embedding model for TigerGraph Vector RAG. Does not replace LLM_MODEL.
# Defaults to Cloudflare BGE small (384-d) on the same OpenAI-compatible gateway.
EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_S=60
EMBEDDING_BATCH_SIZE=16
